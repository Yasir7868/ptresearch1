# Copy to .env.local for development. Set the same variables in Railway for
# production. Never commit real values.

# --- Storefront --------------------------------------------------------------
WP_ORIGIN=https://ptresearch.shop
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# NEXT_PUBLIC_INDEXABLE=true   # production apex only

# --- Admin panel: WooCommerce connection --------------------------------------
# WooCommerce → Settings → Advanced → REST API → Add key.
# User: an Administrator or Shop manager. Permissions: Read/Write.
WOO_CONSUMER_KEY=
WOO_CONSUMER_SECRET=
# "header" (default) or "query" if your host strips the Authorization header.
WOO_AUTH_MODE=header
# Any long random string (e.g. `openssl rand -hex 32`). The same value goes in
# each WooCommerce webhook's Secret field (Settings → Connect webhooks does it).
WOO_WEBHOOK_SECRET=

# --- Admin panel: accounts ------------------------------------------------------
# SQLite file for staff accounts, sessions and the activity log.
# Development default: .data/admin.sqlite. REQUIRED in production and must be on
# persistent storage (Railway: attach a volume, e.g. mounted at /data).
# ADMIN_DB_PATH=/data/admin.sqlite
# One-time secret for creating the first owner at /admin/setup (16+ characters).
ADMIN_SETUP_TOKEN=

# --- Bulk ordering: quote requests ----------------------------------------------
# Where /bulk quote requests are POSTed as JSON. A WordPress REST endpoint, an
# email relay, Zapier/Make/n8n, or a Slack incoming webhook all work.
# Unset = the request is logged server-side and the form still reports success,
# so previews never show a real researcher an error. SET THIS BEFORE LAUNCH.
BULK_QUOTE_WEBHOOK_URL=
# Optional bearer token sent with that POST.
BULK_QUOTE_WEBHOOK_TOKEN=

# --- Payment gateway (custom-site checkout SDK) ---------------------------------
# Supplied by the payment processor with the SDK zip. SERVER-ONLY: the merchant
# token authorizes charges — never prefix it with NEXT_PUBLIC_ and never log it.
PAYMENT_GATEWAY_API_BASE_URL=
PAYMENT_GATEWAY_MERCHANT_TOKEN=
# The public origin the processor should call back on and register for wallets.
# Defaults to NEXT_PUBLIC_SITE_URL when unset.
# SITE_URL=https://ptresearch.shop
